commands:
  01_install_node:
    command: |
      # Install Node.js 18.x from NodeSource repository
      curl -fsSL https://rpm.nodesource.com/setup_18.x | sudo bash -
      sudo yum install -y nodejs
      
      # Verify installation
      echo "Node.js version:"
      node --version
      echo "NPM version:"
      npm --version

container_commands:
  01_install_dependencies:
    command: |
      cd /var/app/staging/
      npm run setup
  02_build:
    command: |
      cd /var/app/staging/
      npm run build
  03_debug_structure:
    command: |
      echo "=== Staging Directory Structure ==="
      ls -la /var/app/staging/
      echo "=== API Directory Structure ==="
      ls -la /var/app/staging/api/
      echo "=== API Dist Directory Structure ==="
      ls -la /var/app/staging/api/dist/
  04_prepare_deployment:
    command: |
      # Clear and create current directory
      rm -rf /var/app/current/*
      mkdir -p /var/app/current
      
      # Debug the copy process
      echo "Copying files from dist..."
      cp -rv /var/app/staging/api/dist/* /var/app/current/
      echo "Copying package.json..."
      cp -v /var/app/staging/api/package.json /var/app/current/
      echo "Copying Procfile..."
      cp -v /var/app/staging/api/Procfile /var/app/current/
      
      # Install dependencies in current directory
      cd /var/app/current
      echo "Installing dependencies in $(pwd)..."
      npm install --production
  05_verify_deployment:
    command: |
      echo "=== Current Directory Structure ==="
      ls -la /var/app/current/
      echo "=== Current Directory Contents ==="
      find /var/app/current -type f -name "*.js" | sort
      echo "=== Process Environment ==="
      env
      echo "=== Node Version ==="
      node --version
      echo "=== NPM Version ==="
      npm --version