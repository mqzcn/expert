files:
  /etc/nginx/conf.d/stripe_webhook.conf:
    mode: "000644"
    owner: root
    group: root
    content: |
      # Nginx config for Stripe Webhook
      # This file is created by .ebextensions/01_nginx_stripe_webhook.config

      # Specific log for Stripe webhooks for easier debugging
      access_log /var/log/nginx/stripe_webhook_access.log main;
      error_log /var/log/nginx/stripe_webhook_error.log warn;

      location ^~ /api/stripe/webhook {
          # Using ^~ for a more definitive prefix match.
          
          # Explicitly allow POST and OPTIONS methods. Deny others.
          limit_except POST OPTIONS {
              deny all;
          }

          # Handle OPTIONS requests (e.g., for preflight checks)
          if ($request_method = OPTIONS) {
              add_header 'Access-Control-Allow-Origin' '*'; # Adjust as necessary for your security policy
              add_header 'Access-Control-Allow-Methods' 'POST, OPTIONS';
              add_header 'Access-Control-Allow-Headers' 'Content-Type, Stripe-Signature'; # Add any other headers Stripe might send
              add_header 'Access-Control-Max-Age' 1728000;
              add_header 'Content-Type' 'text/plain charset=UTF-8';
              add_header 'Content-Length' 0;
              return 204; # No Content for OPTIONS
          }

          client_max_body_size 5M; # Apply specifically to this location

          proxy_set_header   Host $host;
          proxy_set_header   X-Real-IP $remote_addr;
          proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header   X-Forwarded-Proto $scheme;
          
          proxy_pass         http://127.0.0.1:3001; # Node.js app listens on 3001
      }

commands:
  01_create_log_files:
    command: "touch /var/log/nginx/stripe_webhook_access.log && touch /var/log/nginx/stripe_webhook_error.log && chown nginx:nginx /var/log/nginx/stripe_webhook_access.log && chown nginx:nginx /var/log/nginx/stripe_webhook_error.log"
    test: "ls /var/log/nginx" # Simple test to ensure the directory exists
  02_test_nginx_config:
    command: "sudo nginx -t"
    test: "echo 'Testing Nginx config'" # This command itself is the test
  03_reload_nginx:
    command: "sudo systemctl reload nginx"
    # Test is implicitly the success of 02_test_nginx_config. 
    # If 02_test_nginx_config fails, the deployment process (which runs these commands) should ideally halt or report an error.
