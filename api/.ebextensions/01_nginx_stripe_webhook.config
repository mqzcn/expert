files:
  /etc/nginx/conf.d/stripe_webhook.conf:
    mode: "000644"
    owner: root
    group: root
    content: |
      # Nginx config for Stripe Webhook
      # This file is created by .ebextensions/01_nginx_stripe_webhook.config

      location ^~ /api/stripe/webhook {
          # Using ^~ for a more definitive prefix match.
          # If this location matches, Nginx will stop searching for other (e.g., regex) matches.

          client_max_body_size 5M; # Apply specifically to this location

          proxy_set_header   Host $host;
          proxy_set_header   X-Real-IP $remote_addr;
          proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header   X-Forwarded-Proto $scheme;
          
          # Ensure the path is passed correctly, especially if the location match itself might alter it.
          # For `location ^~ /api/stripe/webhook`, requests to /api/stripe/webhook will pass
          # the URI /api/stripe/webhook to the proxied server.
          # Our Node.js app listens on 127.0.0.1:3001 and expects the full path.
          proxy_pass         http://127.0.0.1:3001; # Node.js app listens on 3001
      }

commands:
  01_reload_nginx:
    command: "sudo systemctl reload nginx"
    test: "sudo nginx -t" # Test Nginx config before reloading
