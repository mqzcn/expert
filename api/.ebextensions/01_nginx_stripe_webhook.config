files:
  /etc/nginx/conf.d/stripe_webhook.conf:
    mode: "000644"
    owner: root
    group: root
    content: |
      # Nginx config for Stripe Webhook
      # Increase client_max_body_size for the Stripe webhook endpoint
      client_max_body_size 5M; # Allow up to 5MB for webhook payloads

      location /api/stripe/webhook {
          # Ensure this location is proxied to the Node.js application
          # The specific proxy_pass URL might depend on your Elastic Beanstalk Nginx setup
          # Typically, it's something like http://127.0.0.1:YOUR_NODE_PORT or http://nodejs:YOUR_NODE_PORT
          # Elastic Beanstalk usually sets up Nginx to proxy to localhost on the app's port (e.g., 3001 if that's what your app listens on internally)
          # We will rely on the default proxy_pass from the main server block if possible,
          # by not specifying one here, unless specific overrides are needed.
          # This location block primarily ensures that client_max_body_size is applied
          # and that this specific path is recognized.

          # If the default proxy_pass in Elastic Beanstalk's Nginx config is correctly
          # forwarding to the Node.js app, simply defining the location
          # and setting client_max_body_size might be enough.
          # However, it's safer to ensure the proxy headers are set correctly.

          proxy_set_header   Host $host;
          proxy_set_header   X-Real-IP $remote_addr;
          proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header   X-Forwarded-Proto $scheme;
          proxy_pass         http://127.0.0.1:3001; # Assuming Node.js app listens on 3001 internally on the EC2 instance

          # It's important that this specific location block is processed.
          # If there's a more general location block that also matches, Nginx prefix matching rules apply.
          # /api/stripe/webhook is quite specific.
      }

commands:
  01_reload_nginx:
    command: "sudo systemctl reload nginx"
    test: "sudo nginx -t" # Test Nginx config before reloading

# Note: The port in `proxy_pass http://127.0.0.1:3001;` should match the port
# your Node.js application is configured to listen on *within the EC2 instance*.
# Your Node.js app logs "Server running on port 3001", so 3001 is likely correct.
# Elastic Beanstalk Node.js platforms typically run the app on a specific port (like 8081 by default for older platforms,
# or the PORT env var for newer ones, which you've set to 3001 or it defaults to).
# Nginx then proxies from port 80 (HTTP) / 443 (HTTPS) to this internal application port.
# The `proxy_pass` directive here tells Nginx where to forward requests for this specific location.
