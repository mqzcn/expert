files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_fix_node_dir.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/usr/bin/env bash
      cd /var/app/current
      if [ ! -f "index.js" ]; then
        echo "index.js not found in $(pwd)"
        exit 1
      fi
      echo "Found index.js in $(pwd)" 