# .ebextensions/00_nginx_debug_logging.config
# WARNING: Enables verbose Nginx debug logging. Disable after troubleshooting.

container_commands:
  01_backup_nginx_conf:
    command: |
      echo "Backing up /etc/nginx/nginx.conf to /etc/nginx/nginx.conf.backup"
      sudo cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.backup || echo "Backup failed, proceeding with caution"
  02_enable_nginx_debug_logging:
    command: |
      echo "Attempting to enable Nginx debug logging..."
      # This sed command tries to find any existing error_log directive in nginx.conf's main http block (or global)
      # and replace its log level with 'debug'. It's made more resilient to different existing levels.
      # It targets 'error_log /var/log/nginx/error.log ...;'
      if sudo grep -q "error_log /var/log/nginx/error.log" /etc/nginx/nginx.conf; then
        echo "Found existing error_log directive for /var/log/nginx/error.log. Modifying to debug."
        sudo sed -i 's#\(error_log /var/log/nginx/error.log\).*;#\1 debug;#' /etc/nginx/nginx.conf
      else
        echo "No standard error_log directive found for /var/log/nginx/error.log. Attempting to add one. This is less ideal."
        # This is a fallback and might not work as expected if other error_log directives exist.
        # It attempts to add 'error_log /var/log/nginx/error.log debug;' inside the main 'http {' block.
        # This is complex with sed; a better approach if this is needed is manual config or more advanced .ebextensions.
        echo "WARN: Could not reliably modify nginx.conf to set debug log. Please check Nginx config manually if debug logs don't appear."
      fi
  03_test_nginx_config:
    command: "sudo nginx -t"
    # This command will show output in deployment logs. If it fails, deployment might halt or rollback.
  04_reload_nginx:
    command: "sudo systemctl reload nginx"