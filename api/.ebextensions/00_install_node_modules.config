commands:
  01_install_node:
    command: |
      curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash
      . ~/.nvm/nvm.sh
      nvm install 18
      nvm use 18
      npm install -g npm@latest

container_commands:
  01_install_dependencies:
    command: |
      cd /var/app/staging/
      npm run setup
  02_build:
    command: |
      cd /var/app/staging/
      npm run build
  03_verify_dist:
    command: |
      if [ ! -d "/var/app/staging/api/dist" ]; then
        echo "Dist directory not found!"
        exit 1
      fi
      ls -la /var/app/staging/api/dist
  04_prepare_deployment:
    command: |
      # Clear and create current directory
      rm -rf /var/app/current/*
      mkdir -p /var/app/current
      
      # Copy files directly to current
      cp -r /var/app/staging/api/dist/* /var/app/current/
      cp /var/app/staging/api/package.json /var/app/current/
      cp /var/app/staging/api/Procfile /var/app/current/
      
      # Install dependencies in current directory
      cd /var/app/current
      npm install --production
  05_verify_deployment:
    command: |
      echo "Verifying deployment structure..."
      ls -la /var/app/current
      echo "Checking for index.js..."
      if [ ! -f "/var/app/current/index.js" ]; then
        echo "index.js not found in /var/app/current!"
        exit 1
      fi
      echo "Checking node_modules..."
      if [ ! -d "/var/app/current/node_modules" ]; then
        echo "node_modules not found in /var/app/current!"
        exit 1
      fi