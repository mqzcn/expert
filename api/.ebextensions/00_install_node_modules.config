commands:
  01_install_node:
    command: |
      curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash
      . ~/.nvm/nvm.sh
      nvm install 18
      nvm use 18

container_commands:
  01_install_dependencies:
    command: |
      cd /var/app/staging/
      npm run setup
  02_build:
    command: |
      cd /var/app/staging/
      npm run build
  03_verify_dist:
    command: |
      if [ ! -d "/var/app/staging/api/dist" ]; then
        echo "Dist directory not found!"
        exit 1
      fi
      ls -la /var/app/staging/api/dist
  04_install_production_deps:
    command: |
      cd /var/app/staging/api/dist
      npm install --production
  05_verify_structure:
    command: |
      echo "Checking deployment structure..."
      ls -la /var/app/staging/
      echo "Checking api/dist structure..."
      ls -la /var/app/staging/api/dist
  06_copy_to_current:
    command: |
      mkdir -p /var/app/current/api/dist
      cp -r /var/app/staging/api/dist/* /var/app/current/api/dist/