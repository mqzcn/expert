commands:
  01_install_node:
    command: |
      curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash
      . ~/.nvm/nvm.sh
      nvm install 18
      nvm use 18
      npm install -g npm@latest

container_commands:
  01_install_dependencies:
    command: |
      cd /var/app/staging/
      npm run setup
  02_build:
    command: |
      cd /var/app/staging/
      npm run build
  03_verify_dist:
    command: |
      if [ ! -d "/var/app/staging/api/dist" ]; then
        echo "Dist directory not found!"
        exit 1
      fi
      ls -la /var/app/staging/api/dist
  04_prepare_deployment:
    command: |
      # Create deployment structure
      mkdir -p /var/app/staging/deployment
      cp -r /var/app/staging/api/dist/* /var/app/staging/deployment/
      cp /var/app/staging/api/package.json /var/app/staging/deployment/
      
      # Install dependencies in deployment directory
      cd /var/app/staging/deployment
      npm install --production
      
      # Copy to final location
      mkdir -p /var/app/current
      cp -r /var/app/staging/deployment/* /var/app/current/
  05_verify_deployment:
    command: |
      echo "Verifying deployment structure..."
      ls -la /var/app/current
      echo "Checking for index.js..."
      if [ ! -f "/var/app/current/index.js" ]; then
        echo "index.js not found!"
        exit 1
      fi