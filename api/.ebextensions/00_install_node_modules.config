commands:
  01_install_node:
    command: |
      curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash
      . ~/.nvm/nvm.sh
      nvm install 18
      nvm use 18

container_commands:
  01_install_dependencies:
    command: |
      cd /var/app/staging/
      npm run setup
  02_build:
    command: |
      cd /var/app/staging/
      npm run build
  03_verify_dist:
    command: |
      if [ ! -d "/var/app/staging/api/dist" ]; then
        echo "Dist directory not found!"
        exit 1
      fi
      ls -la /var/app/staging/api/dist
  04_copy_dist:
    command: |
      cp -r /var/app/staging/api/dist/* /var/app/staging/
      cp /var/app/staging/api/package.json /var/app/staging/
  05_install_production_deps:
    command: |
      cd /var/app/staging/
      npm install --production 